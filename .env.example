# Copy to .env; run npm run db:setup before npm run dev.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=smartkos
DB_PASSWORD=replace-with-your-database-password
DB_NAME=smartkos_business
# Only needed if using compose.yaml; use a different password from DB_PASSWORD.
MYSQL_ROOT_PASSWORD=replace-with-your-mysql-root-password
# Used only when creating the first admin. Change before running db:setup.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@smartkos.local
ADMIN_PASSWORD=GantiPasswordAdmin!2026
# Leave blank to disable transfer submissions until your real account is set.
BANK_NAME=
BANK_ACCOUNT=
BANK_HOLDER=
CONTACT_EMAIL=halo@example.com
CONTACT_PHONE=
